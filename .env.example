# Aether — copy to .env

XAI_API_KEY=your_xai_api_key_here
X_BEARER_TOKEN=your_x_bearer_token_here
GROK_VOICE_API_KEY=your_grok_voice_key_here

# Postgres (Docker compose defaults)
# AETHER_DATABASE_URL=postgresql://aether:aether_local_dev@127.0.0.1:5432/aether

# Optional Fernet key (auto-created in ~/.aether/memory.key for file backend)
# AETHER_MEMORY_KEY=

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# AETHER_OLLAMA_EMBED=nomic-embed-text
# AETHER_OLLAMA_CHAT=llama3.2

# Model override
# AETHER_MODEL=grok-4.20-multi-agent

# Kill switch
# AETHER_DISABLED=0
