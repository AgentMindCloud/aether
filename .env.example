# Aether environment variables
# Copy to .env and fill real values. Never commit .env

# Required for live mode (xAI / Grok)
XAI_API_KEY=your_xai_api_key_here

# Required for live X context + mentions / replies
X_BEARER_TOKEN=your_x_bearer_token_here
X_OAUTH_TOKEN=

# Required for real-time voice (Think Fast 2.0 / Realtime)
GROK_VOICE_API_KEY=your_grok_voice_key_here

# Optional: Fernet key for memory encryption (auto-generated in ~/.aether/memory.key if unset)
# AETHER_MEMORY_KEY=

# Kill switch (set to 1 to halt all Aether activity)
# AETHER_DISABLED=0

# Optional overrides
# AETHER_MEMORY_CROSS_SESSION=false
# AETHER_PROACTIVE_ENABLED=true
