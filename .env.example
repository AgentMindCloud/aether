# Aether — copy to .env

XAI_API_KEY=your_xai_api_key_here
X_BEARER_TOKEN=your_x_bearer_token_here
GROK_VOICE_API_KEY=your_grok_voice_key_here

# Postgres — default matches local instance:
#   Host: localhost  Port: 5432  User: postgres  Password: postgres  Database: postgres
# AETHER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Optional Fernet key (file backend only)
# AETHER_MEMORY_KEY=

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# AETHER_OLLAMA_EMBED=nomic-embed-text
# AETHER_OLLAMA_CHAT=llama3.2

# AETHER_MODEL=grok-4.20-multi-agent
# AETHER_DISABLED=0
